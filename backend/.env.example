# CompetitorIQ Environment Configuration
PROJECT_NAME="CompetitorIQ"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration
# PostgreSQL format: postgresql://username:password@localhost:5432/competitoriq
# SQLite fallback (default for zero-setup local run): sqlite:///./competitoriq.db
DATABASE_URL="sqlite:///./competitoriq.db"

# Google Gemini API
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Scraping & Security Configuration
MAX_PAGES_PER_COMPETITOR=6
SCRAPE_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE_BYTES=2097152
USER_AGENT="CompetitorIQ-ResearchBot/1.0 (+https://competitoriq.local/bot; respect-robots)"
ALLOW_LOCAL_URLS_FOR_TESTING=false
