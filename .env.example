# CompetitorIQ Global Environment Configuration

# Database (PostgreSQL for Docker, SQLite fallback for zero-setup local dev)
DATABASE_URL="sqlite:///./competitoriq.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/competitoriq"

# Google Gemini API Key (Get yours at https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Scraping & Security bounds
MAX_PAGES_PER_COMPETITOR=6
SCRAPE_TIMEOUT_SECONDS=15
MAX_PAGE_SIZE_BYTES=2097152
ALLOW_LOCAL_URLS_FOR_TESTING=false
